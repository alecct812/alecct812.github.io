---
import LabMap from './LabMap.astro';
import PairsGrid from './PairsGrid.astro';
import { RIGOR } from '../../data/tcc';
import { num, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).tcc;
const lastCol = d.gap.cols.length - 1;

const rigor = [
  [num(lang, RIGOR.checks), d.rigor.items.checks],
  [num(lang, RIGOR.mutations), d.rigor.items.mutations],
  [num(lang, RIGOR.verifiers), d.rigor.items.verifiers],
  [num(lang, RIGOR.steps), d.rigor.items.steps],
  [`${RIGOR.pairsApproved}/10`, d.rigor.items.pairs],
] as const;

---

<section class="secao">
  <div class="wrap pergunta">
    <div>
      <h2>{d.question.heading}</h2>
      <p class="pergunta__lede">{d.question.lede}</p>
    </div>
    <div class="pergunta__apoio">
      <p>{d.question.context}</p>
      <p>{d.question.hypothesis}</p>
      <p class="apoio">{d.advisor}</p>
    </div>
  </div>
</section>

<section class="secao">
  <div class="wrap">
    <h2>{d.gap.heading}</h2>
    <p class="intro">{d.gap.intro}</p>
    <div class="tabela" role="region" aria-label={d.gap.heading} tabindex="0">
      <table>
        <thead>
          <tr>{d.gap.cols.map((c) => <th scope="col">{c}</th>)}</tr>
        </thead>
        <tbody>
          {
            d.gap.rows.map((row, i) => (
              <tr class:list={[i === d.gap.rows.length - 1 && 'tabela__ambiente']}>
                {row.map((cell, j) => (j === 0 ? <th scope="row">{cell}</th> : <td class:list={[j === lastCol && 'tabela__pivota']}>{cell}</td>))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="secao">
  <div class="wrap">
    <h2>{d.arms.heading}</h2>
    <p class="intro">{d.arms.intro}</p>
    <div class="bracos">
      <div class="braco braco--a">
        <h3>{d.arms.aTitle}</h3>
        <p>{d.arms.aBody}</p>
        <ul class="ve mono" aria-hidden="true">
          {d.arms.seesA.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="braco braco--b">
        <h3>{d.arms.bTitle}</h3>
        <p>{d.arms.bBody}</p>
        <ul class="ve ve--some mono" aria-hidden="true">
          {d.arms.seesB.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
    <p class="principio">{d.arms.principle}</p>
  </div>
</section>

<section class="secao" id="laboratorio">
  <div class="wrap">
    <h2>{d.lab.heading}</h2>
    <p class="intro">{d.lab.intro}</p>
    <LabMap lang={lang} />
  </div>
</section>

<section class="secao" id="resultados">
  <div class="wrap">
    <h2>{d.results.heading}</h2>
    <p class="intro">{d.results.intro}</p>
    <PairsGrid lang={lang} />
  </div>
</section>

<section class="secao">
  <div class="wrap limite">
    <h2>{d.limitation.heading}</h2>
    <div class="limite__texto">
      <p class="limite__primeiro">{d.limitation.p1}</p>
      <p>{d.limitation.p2}</p>
      <p>{d.limitation.p3}</p>
    </div>
  </div>
</section>

<section class="secao">
  <div class="wrap">
    <h2>{d.rigor.heading}</h2>
    <p class="intro">{d.rigor.intro}</p>
    <dl class="rigor">
      {
        rigor.map(([value, label]) => (
          <div>
            <dt>{value}</dt>
            <dd>{label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .intro {
    margin-top: var(--space-4);
    color: var(--texto-2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 62ch;
  }

  /* A pergunta */
  .pergunta {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-7);
    align-items: start;
  }

  .pergunta__lede {
    margin-top: var(--space-5);
    font-size: var(--step-3);
    line-height: 1.25;
    font-weight: 500;
    max-width: 30ch;
  }

  .pergunta__apoio {
    display: grid;
    gap: var(--space-4);
    color: var(--texto-2);
    padding-top: 0.6rem;
  }

  /* A lacuna */
  .tabela {
    margin-top: var(--space-6);
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    text-align: left;
  }

  thead th {
    color: var(--texto-2);
    font-size: var(--step--1);
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
    line-height: 1.3;
  }

  th,
  td {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--linha);
    vertical-align: baseline;
  }

  tbody th {
    font-weight: 600;
  }

  tbody td {
    color: var(--texto-2);
  }

  .tabela__ambiente th,
  .tabela__ambiente td {
    color: var(--texto);
    border-bottom-color: var(--verde);
  }

  .tabela__ambiente .tabela__pivota {
    color: var(--verde);
    font-weight: 700;
  }

  /* Os dois braços */
  .bracos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .braco {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 3px solid var(--cor);
  }

  .braco--a {
    --cor: var(--verde);
  }

  .braco--b {
    --cor: var(--ambar);
  }

  .braco p {
    color: var(--texto-2);
  }

  .ve {
    display: grid;
    gap: 2px;
    margin-top: var(--space-2);
    padding: var(--space-4);
    background: var(--painel);
    border-radius: var(--raio);
    color: var(--cor);
  }

  /* A memória conversacional envelhece: o mais antigo fica mais apagado. */
  .ve--some li:nth-child(1) {
    opacity: 0.3;
  }

  .ve--some li:nth-child(2) {
    opacity: 0.45;
  }

  .ve--some li:nth-child(3) {
    opacity: 0.65;
  }

  .ve--some li:nth-child(4) {
    opacity: 0.82;
  }

  .principio {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--linha);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 62ch;
  }

  /* O que o resultado não autoriza: mesmo peso do resultado. */
  .limite {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: start;
  }

  .limite__texto {
    display: grid;
    gap: var(--space-4);
    color: var(--texto-2);
  }

  .limite__primeiro {
    color: var(--texto);
    font-size: var(--step-2);
    line-height: 1.35;
    font-weight: 500;
  }

  /* Rigor */
  .rigor {
    margin: var(--space-6) 0 0;
    border-top: 1px solid var(--linha);
  }

  .rigor div {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--linha);
  }

  .rigor dt {
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-5);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .rigor dd {
    color: var(--texto-2);
    max-width: 56ch;
  }

  @media (max-width: 860px) {
    .pergunta,
    .limite,
    .bracos {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .rigor div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
