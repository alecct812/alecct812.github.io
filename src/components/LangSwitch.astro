---
import { t, type Lang } from '../i18n';
import { switchLangPath } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const target = lang === 'pt' ? 'en' : 'pt-BR';
---

<a class="troca" href={switchLangPath(Astro.url.pathname)} hreflang={target} lang={target} aria-label={d.langSwitch.aria}>
  {d.langSwitch.label}
</a>

<style>
  .troca {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .troca:hover {
    border-color: var(--texto-2);
  }
</style>
