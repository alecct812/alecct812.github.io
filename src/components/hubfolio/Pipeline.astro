---
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).hubfolio;
---

<section class="secao">
  <div class="wrap">
    <h2>{d.heading}</h2>
    <p class="intro">{d.intro}</p>

    <!-- A ordem é a do dado: é uma sequência de verdade, por isso a lista é numerada. -->
    <div class="fluxo-caixa" data-fluxo>
    <span class="trilho" aria-hidden="true"><span class="trilho__dado"></span></span>
    <ol class="fluxo" aria-label={d.aria}>
      {
        d.stages.map((s, i) => (
          <li class="etapa">
            <span class="etapa__n mono" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{s.name}</h3>
            <p class="etapa__servico mono">{s.service}</p>
            <p class="etapa__nota">{s.note}</p>
          </li>
        ))
      }
    </ol>
    </div>

    <dl class="medidas">
      {
        d.metrics.map((m) => (
          <div>
            <dt>{m.value}</dt>
            <dd>{m.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .intro {
    margin-top: var(--space-4);
    color: var(--texto-2);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 62ch;
  }

  .fluxo-caixa {
    position: relative;
    margin-top: var(--space-7);
  }

  .fluxo {
    --n: 6;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-6);
  }

  /* O trilho por onde o dado passa. Ele é um contêiner de tamanho, para o dado poder
     se mover com transform (barato, sem recalcular o layout) usando o comprimento do trilho. */
  .trilho {
    position: absolute;
    top: 0.9rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--linha);
    container-type: size;
    overflow: hidden;
  }

  .trilho__dado {
    position: absolute;
    top: 0;
    left: 0;
    width: 3.5rem;
    height: 100%;
    background: linear-gradient(to right, transparent, var(--texto));
    animation: dado 5.5s linear infinite;
    will-change: transform;
  }

  /* Fora da tela o dado para. */
  .fluxo-caixa[data-pausado] .trilho__dado {
    animation-play-state: paused;
  }

  @keyframes dado {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(100cqw - 3.5rem));
    }
  }

  .etapa {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .etapa__n {
    position: absolute;
    top: calc(-1 * var(--space-6) + 0.9rem - 0.8rem);
    left: 0;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 2px solid var(--texto-2);
    border-radius: 50%;
    background: var(--tinta);
    color: var(--texto);
    font-size: 0.68rem;
    z-index: 1;
  }

  .etapa h3 {
    font-size: var(--step-2);
  }

  .etapa__servico {
    color: var(--texto);
  }

  .etapa__nota {
    color: var(--texto-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .medidas {
    margin: var(--space-7) 0 0;
    border-top: 1px solid var(--linha);
  }

  .medidas div {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--linha);
  }

  .medidas dt {
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-5);
    line-height: 1;
  }

  .medidas dd {
    color: var(--texto-2);
  }

  /* Sem largura para seis colunas, o trilho fica em pé, à esquerda. */
  @media (max-width: 1040px) {
    .fluxo {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding-top: 0;
      padding-left: 3rem;
    }

    .trilho {
      top: 0;
      bottom: 0;
      left: 0.8rem;
      right: auto;
      width: 2px;
      height: auto;
    }

    .trilho__dado {
      width: 100%;
      height: 3.5rem;
      background: linear-gradient(to bottom, transparent, var(--texto));
      animation-name: dado-em-pe;
    }

    @keyframes dado-em-pe {
      from {
        transform: translateY(0);
      }

      to {
        transform: translateY(calc(100cqh - 3.5rem));
      }
    }

    .etapa__n {
      top: 0.15rem;
      left: -3rem;
    }
  }

  @media (max-width: 560px) {
    .medidas div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trilho__dado {
      display: none;
    }
  }
</style>

<script>
  // Pausa o dado quando o diagrama sai da tela. Sem JavaScript ele só continua andando.
  let io: IntersectionObserver | null = null;

  document.addEventListener('astro:page-load', () => {
    io?.disconnect();
    io = null;
    const el = document.querySelector<HTMLElement>('[data-fluxo]');
    if (!el) return;
    io = new IntersectionObserver((entries) => {
      const visible = entries[entries.length - 1]?.isIntersecting ?? true;
      el.toggleAttribute('data-pausado', !visible);
    });
    io.observe(el);
  });

  document.addEventListener('astro:before-swap', () => {
    io?.disconnect();
    io = null;
  });
</script>
