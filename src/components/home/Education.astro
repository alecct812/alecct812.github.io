---
import { CERTIFICATES, EDUCATION, LANGUAGES } from '../../data/profile';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).education;
---

<section class="secao" id="formacao">
  <div class="wrap form">
    <div>
      <h2>{d.heading}</h2>
      <p class="form__escola">{EDUCATION.school}</p>
      <p>{EDUCATION.degree[lang]}</p>
      <p class="apoio">
        {EDUCATION.place[lang]}
        <br />
        {EDUCATION.period[lang]}
      </p>
    </div>
    <div>
      <h3>{d.certificates}</h3>
      <ul class="form__lista">
        {CERTIFICATES.map((c) => <li>{c[lang]}</li>)}
      </ul>
    </div>
    <div>
      <h3>{d.languages}</h3>
      <ul class="form__lista">
        {
          LANGUAGES.map((l) => (
            <li>
              {l.name[lang]} <span class="apoio">{l.level[lang]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .form {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    gap: var(--space-6);
    align-items: start;
  }

  .form__escola {
    margin-top: var(--space-5);
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: 75%;
  }

  h3 {
    font-size: var(--step-1);
    color: var(--texto-2);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
    padding-top: 0.6rem;
  }

  .form__lista {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 860px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
